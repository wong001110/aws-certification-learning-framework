{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AWS Certification Pack",
  "type": "object",
  "required": ["schema_version", "certification", "source", "question_types", "domains", "depth_profile"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "certification": {
      "type": "object",
      "required": ["id", "name", "level", "status", "verified_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{2,3}-C[0-9]{2}$"},
        "name": {"type": "string", "minLength": 3},
        "level": {"enum": ["foundational", "associate", "professional", "specialty"]},
        "status": {"enum": ["active", "beta", "retiring", "retired"]},
        "verified_at": {"type": "string", "format": "date"}
      },
      "additionalProperties": true
    },
    "source": {"type": "object", "required": ["exam_guide"], "properties": {"exam_guide": {"type": "string", "format": "uri"}}, "additionalProperties": true},
    "question_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["multiple_choice", "multiple_response", "ordering", "matching"]}},
    "domains": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "weight"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "weight": {"type": "integer", "minimum": 1, "maximum": 100}}, "additionalProperties": false}},
    "depth_profile": {"enum": ["foundational", "associate", "professional", "specialty"]}
  },
  "additionalProperties": true
}
