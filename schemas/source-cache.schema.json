{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Official AWS Source Cache",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "title",
    "url",
    "fetched_at",
    "content_type",
    "content_sha256",
    "chunk_count",
    "chunks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_type": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 1
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "heading",
          "text",
          "character_count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 20
          },
          "character_count": {
            "type": "integer",
            "minimum": 20
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
