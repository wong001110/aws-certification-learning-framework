{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning Attempt",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "certification_id",
    "occurred_at",
    "activity_type",
    "result",
    "objective_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
    },
    "certification_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-C[0-9]{2}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "activity_type": {
      "enum": [
        "question",
        "quiz",
        "mock_exam",
        "lesson_check",
        "hands_on"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "question_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "enum": [
        "correct",
        "incorrect",
        "partial",
        "skipped"
      ]
    },
    "objective_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "domain_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "response": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "confidence_before": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_after": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
