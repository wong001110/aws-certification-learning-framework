{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original AWS Certification Practice Question",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "certification_id",
    "domain_id",
    "difficulty",
    "question_type",
    "language",
    "skills_tested",
    "scenario",
    "stem",
    "correct_answers",
    "explanation",
    "sources",
    "review"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{6,64}$"
    },
    "certification_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-C[0-9]{2}$"
    },
    "domain_id": {
      "type": "string",
      "minLength": 2
    },
    "objective_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
      }
    },
    "difficulty": {
      "enum": [
        "teaching",
        "exam",
        "pressure"
      ]
    },
    "question_type": {
      "enum": [
        "multiple_choice",
        "multiple_response",
        "ordering",
        "matching"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "skills_tested": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "context",
        "problem",
        "constraints"
      ],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 20
        },
        "current_state": {
          "type": "string"
        },
        "problem": {
          "type": "string",
          "minLength": 10
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "enum": [
                  "business",
                  "security",
                  "reliability",
                  "performance",
                  "operations",
                  "cost",
                  "compliance",
                  "data",
                  "ai_responsibility",
                  "knowledge"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 5
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stem": {
      "type": "string",
      "minLength": 10
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "classification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "text": {
            "type": "string",
            "minLength": 5
          },
          "classification": {
            "enum": [
              "best_answer",
              "correct_component",
              "plausible_but_incomplete",
              "violates_requirement",
              "wrong_service_boundary",
              "excessive_operational_overhead",
              "unnecessary_cost",
              "out_of_scope",
              "incorrect_fact"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "responses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "correct_answers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisive_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "explanation": {
      "type": "object",
      "required": [
        "summary",
        "option_analysis"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "option_analysis": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 10
          }
        },
        "learning_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          }
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "accessed_at"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "technical_accuracy",
        "answer_uniqueness",
        "distractor_quality",
        "depth_alignment",
        "originality"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "approved",
            "rewrite",
            "rejected",
            "needs_revalidation"
          ]
        },
        "technical_accuracy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "answer_uniqueness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "distractor_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "depth_alignment": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "originality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "question_type": {
            "enum": [
              "multiple_choice",
              "multiple_response"
            ]
          }
        }
      },
      "then": {
        "required": [
          "options"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "question_type": {
            "const": "ordering"
          }
        }
      },
      "then": {
        "required": [
          "items"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "question_type": {
            "const": "matching"
          }
        }
      },
      "then": {
        "required": [
          "prompts",
          "responses"
        ]
      }
    }
  ],
  "additionalProperties": false
}
