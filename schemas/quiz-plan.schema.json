{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Quiz or Mock Exam Plan",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "certification_id",
    "mode",
    "generated_at",
    "policy_version",
    "question_count",
    "domain_distribution",
    "question_type_distribution",
    "objective_ids",
    "slots",
    "notice"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 5
    },
    "certification_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-C[0-9]{2}$"
    },
    "mode": {
      "enum": [
        "adaptive",
        "focused",
        "mock"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string"
    },
    "question_count": {
      "type": "integer",
      "minimum": 1
    },
    "time_limit_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "domain_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "question_type_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "objective_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "position",
          "domain_id",
          "objective_ids",
          "difficulty",
          "question_type",
          "source",
          "selection_reason"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "domain_id": {
            "type": "string"
          },
          "objective_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "enum": [
              "teaching",
              "exam",
              "pressure"
            ]
          },
          "question_type": {
            "enum": [
              "multiple_choice",
              "multiple_response",
              "ordering",
              "matching"
            ]
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "question_id",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "const": "existing"
                  },
                  "question_id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "authoring_constraints"
                ],
                "properties": {
                  "kind": {
                    "const": "generate"
                  },
                  "authoring_constraints": {
                    "type": "object",
                    "required": [
                      "objective_ids",
                      "domain_id",
                      "difficulty",
                      "question_type",
                      "official_sources_required",
                      "original_content_required"
                    ],
                    "properties": {
                      "objective_ids": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      },
                      "domain_id": {
                        "type": "string"
                      },
                      "difficulty": {
                        "enum": [
                          "teaching",
                          "exam",
                          "pressure"
                        ]
                      },
                      "question_type": {
                        "enum": [
                          "multiple_choice",
                          "multiple_response",
                          "ordering",
                          "matching"
                        ]
                      },
                      "official_sources_required": {
                        "const": true
                      },
                      "original_content_required": {
                        "const": true
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "selection_reason": {
            "type": "string",
            "minLength": 5
          }
        },
        "additionalProperties": false
      }
    },
    "notice": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}
